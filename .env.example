# Copy to ".env" at this repo root (never commit ".env").

# --- TestRelic MCP (Cursor: .cursor/mcp.json uses npx @testrelic/mcp) ---
# Create a personal MCP token and wire it per https://docs.testrelic.ai/mcp/authentication
# (or run: npx -y @testrelic/mcp@3.0.0 login)
# TESTRELIC_MCP_TOKEN=

# --- Production uploads (default API host is in each .testrelic/testrelic-config.json) ---
# TESTRELIC_API_KEY=


# Optional: override production API host when not using TESTRELIC_STAGE_* above.
# TESTRELIC_CLOUD_ENDPOINT=
