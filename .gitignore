node_modules/
test-results/
package-lock.json
.DS_Store

# Local secrets (e.g. TESTRELIC_API_KEY) — never commit
.env
.env.local
.env.*.local

# Editor / agent scratch
.cursor/
.vscode/

# Shared mobile binaries (see nodejs/mobile-apps/README.md)
nodejs/mobile-apps/*.apk
nodejs/mobile-apps/*.ipa
nodejs/mobile-apps/*.aab
nodejs/mobile-apps/*.app

# TestRelic upload queue (local retries; do not commit)
**/.testrelic/queue/

# TestRelic local cache + run telemetry (machine-specific; not source)
**/.testrelic/cache/
.testrelic-output/
.testrelic-cache/

# TestRelic test artifacts (screenshots/videos produced by runs)
**/test-results/artifacts/
nodejs/appium/artifacts/

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.deepeval*
# Python demo verification artifacts (only the servers + verify.py are tracked)
python/**/verification/*.jsonl
python/**/verification/*.log
python/**/verification/*.out
python/**/verification/_*.py
python/**/verification/*.json
