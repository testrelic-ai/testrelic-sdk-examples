# Copy to .env and fill in. The TestRelic plugins expand $TESTRELIC_API_KEY from
# the environment (the value never needs to live in testrelic-config.json).

# Real cloud upload (get a key from the TestRelic dashboard; starts with tr_)
TESTRELIC_API_KEY=tr_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Endpoints (defaults shown). pytest/playwright use TESTRELIC_CLOUD_ENDPOINT;
# deepeval uses TESTRELIC_BASE_URL (note the /evals suffix).
TESTRELIC_CLOUD_ENDPOINT=https://platform.testrelic.ai/api/v1
TESTRELIC_BASE_URL=https://platform.testrelic.ai/api/v1/evals

# realtime + batch
TESTRELIC_UPLOAD_STRATEGY=both
